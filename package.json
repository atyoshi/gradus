{
  "name": "gradus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs --dev",
    "start": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "desktop": "npm run build && electron .",
    "build:mac": "npm run build && electron-builder --mac --arm64",
    "build:mac:intel": "npm run build && electron-builder --mac --x64"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "main": "macos/main.cjs",
  "description": "A private, offline counterpoint studio for macOS",
  "author": "Gradus contributors",
  "build": {
    "appId": "org.gradus.counterpoint",
    "productName": "Gradus ad Parnassum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "macos/main.cjs",
      "server.mjs",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "dmg": {
      "title": "Gradus ad Parnassum",
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 420,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
